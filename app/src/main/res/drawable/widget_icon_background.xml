<?xml version="1.0" encoding="utf-8"?>
<!--
  The same charcoal as the launcher icon's adaptive-icon background
  (ic_launcher_background) — the widget's icon tile is meant to read as
  the app icon itself, not a themed card, so it doesn't follow the
  light/dark widget colors the label text does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ic_launcher_background" />
    <corners android:radius="18dp" />
</shape>
